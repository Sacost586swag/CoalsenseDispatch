{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "tsconfig.base.json",
    ".prettierrc.json",
    "pyproject.toml",
    "uv.lock",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "audit": { "dependsOn": ["audit:licenses", "audit:imports"], "cache": false },
    "audit:licenses": { "cache": false },
    "audit:imports": { "cache": false },
    "lint": {},
    "typecheck": {},
    "test": { "passThroughEnv": ["COALSENSE_SKIP_NETWORK_TESTS"] },
    "build": { "outputs": ["dist/**"] }
  }
}
