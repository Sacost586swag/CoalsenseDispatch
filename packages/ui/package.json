{
  "name": "@coalsense/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./dist/components/index.js"
    },
    "./components.css": "./src/components/components.css",
    "./fonts.css": "./src/fonts/fonts.css"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" && vitest run",
    "build": "tsc -p tsconfig.build.json --noEmit false --outDir dist",
    "catalog": "vite .catalog --host 127.0.0.1",
    "test:a11y": "playwright test",
    "test:integration": "playwright test --grep \"keyboard dialog\"",
    "build:catalog": "vite build .catalog --outDir ../catalog-dist"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "sideEffects": [
    "*.css"
  ]
}
