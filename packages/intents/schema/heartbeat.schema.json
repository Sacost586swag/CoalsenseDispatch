{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coalsense:heartbeat:1",
  "$ref": "#/$defs/HeartbeatEvent",
  "$defs": {
    "Modality": {
      "enum": ["voice", "head_gesture", "keyboard_mouse", "gaze", "switch_scan"]
    },
    "StopRouteReason": {
      "enum": [
        "starting",
        "healthy",
        "device_unavailable",
        "model_loading",
        "adapter_unresponsive",
        "stop_unbound",
        "stale",
        "stopped"
      ]
    },
    "StopRouteHealth": {
      "type": "object",
      "properties": {
        "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modality": { "$ref": "#/$defs/Modality" },
        "healthy": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/StopRouteReason" }
      },
      "required": ["identifier", "modality", "healthy", "reason"],
      "additionalProperties": false,
      "if": { "properties": { "healthy": { "const": true } } },
      "then": { "properties": { "reason": { "const": "healthy" } } },
      "else": { "properties": { "reason": { "not": { "const": "healthy" } } } }
    },
    "StopHealthSnapshot": {
      "type": "object",
      "properties": {
        "stop_reachable": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "updated_at": { "type": "string", "format": "date-time" },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/StopRouteHealth" } }
      },
      "required": ["stop_reachable", "revision", "updated_at", "routes"],
      "additionalProperties": false,
      "if": { "properties": { "stop_reachable": { "const": true } } },
      "then": {
        "properties": {
          "routes": { "contains": { "properties": { "healthy": { "const": true } } } }
        }
      },
      "else": {
        "properties": {
          "routes": { "not": { "contains": { "properties": { "healthy": { "const": true } } } } }
        }
      }
    },
    "HeartbeatEvent": {
      "type": "object",
      "properties": {
        "event": { "const": "heartbeat" },
        "schema_version": { "const": 1 },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "wall_ts": { "type": "string", "format": "date-time" },
        "state": { "$ref": "#/$defs/StopHealthSnapshot" }
      },
      "required": ["event", "schema_version", "instance_id", "sequence", "wall_ts", "state"],
      "additionalProperties": false
    }
  }
}
