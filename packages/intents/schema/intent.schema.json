{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coalsense:intent:1",
  "title": "Intent",
  "description": "Intención normalizada. El núcleo fija actor, adaptador, modalidad y prioridad desde la sesión autenticada.",
  "oneOf": [
    {
      "$ref": "#/$defs/ControlStopIntent"
    },
    {
      "$ref": "#/$defs/ControlUndoIntent"
    },
    {
      "$ref": "#/$defs/HelpRequestHumanIntent"
    },
