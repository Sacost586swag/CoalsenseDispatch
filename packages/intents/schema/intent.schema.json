    "CommandInvokePayload": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "required": ["name", "parameters"],
      "additionalProperties": false
    },
    "ControlStopIntent": {
      "allOf": [
        {
          "$ref": "#/$defs/Envelope"
