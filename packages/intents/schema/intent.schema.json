        {
          "type": "object",
          "properties": {
            "type": {
              "const": "control.stop"
            },
            "priority": {
              "const": "preemptive"
            },
            "payload": {
              "$ref": "#/$defs/EmptyPayload"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": ["type", "priority", "payload"]
        }
      ],
      "unevaluatedProperties": false
