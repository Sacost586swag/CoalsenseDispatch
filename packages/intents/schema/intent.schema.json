      "$ref": "#/$defs/UiSelectTargetIntent"
    },
    {
      "$ref": "#/$defs/ModeSetIntent"
    },
    {
      "$ref": "#/$defs/InputPauseIntent"
    },
    {
      "$ref": "#/$defs/InputResumeIntent"
    },
    {
      "$ref": "#/$defs/ProfileSwitchIntent"
    },
    {
      "$ref": "#/$defs/CalibrationRequestIntent"
    },
    {
      "$ref": "#/$defs/CommandInvokeIntent"
    }
  ],
  "$defs": {
    "Modality": {
      "enum": ["voice", "head_gesture", "keyboard_mouse", "gaze", "switch_scan"]
    },
    "ActorOrigin": {
      "enum": ["person", "caregiver", "system"]
    },
    "Priority": {
      "enum": ["preemptive", "normal"]
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_origin": {
          "$ref": "#/$defs/ActorOrigin"
        },
        "monotonic_ts": {
          "type": "integer",
          "minimum": 0,
          "description": "[SUPUESTO] Microsegundos del reloj monotónico local (monotonic_ns // 1000), exactos en JSON y JavaScript; no persistir entre arranques.",
          "maximum": 9007199254740991
        },
        "wall_ts": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "modality", "adapter", "actor_origin", "monotonic_ts", "wall_ts"]
    },
    "EmptyPayload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "PointerMovePayload": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["relative", "absolute"]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": ["mode", "x", "y"],
      "additionalProperties": false
    },
    "PointerButtonPayload": {
      "type": "object",
      "properties": {
        "button": {
          "enum": ["left", "right", "middle"]
        }
      },
      "required": ["button"],
      "additionalProperties": false
    },
    "PointerScrollPayload": {
      "type": "object",
      "properties": {
        "dx": {
          "type": "number"
        },
        "dy": {
          "type": "number"
        }
      },
      "required": ["dx", "dy"],
      "additionalProperties": false
    },
    "KeyPressPayload": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["keys"],
      "additionalProperties": false
    },
    "TextInsertPayload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "TextDictationPayload": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        },
        "segment_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["text", "final"],
      "additionalProperties": false
    },
    "NavSelectPayload": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "UiNumbersPayload": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "UiGridPayload": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "cell": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "UiSelectPayload": {
      "type": "object",
      "properties": {
        "by": {
          "enum": ["number", "label", "id", "grid"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["by", "value"],
      "additionalProperties": false
    },
    "ModeSetPayload": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["command", "dictation", "sleep"]
        }
      },
      "required": ["mode"],
      "additionalProperties": false
