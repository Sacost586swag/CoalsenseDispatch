{
  "name": "@coalsense/audit",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "uv run --locked ruff check .",
    "typecheck": "uv run --locked mypy src",
    "test": "uv run --locked pytest",
    "audit:licenses": "uv run --locked python -m coalsense_audit.licenses",
    "audit:imports": "uv run --locked python -m coalsense_audit.imports",
    "audit:secrets": "uv run --locked python -m coalsense_audit.secrets",
    "audit:traceability": "uv run --locked python -m coalsense_audit.traceability --check",
    "audit:copy": "uv run --locked python -m coalsense_audit.copy"
  }
}
